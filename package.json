{
  "name": "bulesky",
  "private": true,
  "version": "0.1.0",
  "description": "心灵星空 — an anonymous, borderless starry-sky whisper box.",
  "scripts": {
    "dev": "wrangler pages dev public --d1 DB=bulesky-db",
    "deploy": "wrangler pages deploy public",
    "db:create": "wrangler d1 create bulesky-db",
    "db:migrate:local": "wrangler d1 execute bulesky-db --local --file=migrations/0001_init.sql",
    "db:migrate:remote": "wrangler d1 execute bulesky-db --remote --file=migrations/0001_init.sql"
  },
  "devDependencies": {
    "wrangler": "^3.90.0"
  }
}
